      "node_modules/default-browser/**/*",
      "node_modules/define-lazy-prop/**/*"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-syntax-import-meta": "^7.10.4",
    "@babel/preset-env": "^7.25.3"
