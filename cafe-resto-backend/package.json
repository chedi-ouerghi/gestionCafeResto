{
  "name": "cafe-resto-backend",
  "version": "1.0.0",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "cafe",
    "restaurant",
    "backend",
    "nodejs"
  ],
  "author": "Votre Nom",
  "license": "ISC",
  "description": "Backend for the cafe-resto application",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
